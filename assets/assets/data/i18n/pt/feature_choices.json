{
  "optionSources": {
    "battle_master_maneuvers": {
      "commanders_strike": {
        "name": "Ataque do Comandante",
        "description": "Quando você realiza a ação de Ataque, você pode renunciar a um ataque e usar uma ação bônus para direcionar um aliado para atacar."
      },
      "disarming_attack": {
        "name": "Desarmando Ataque",
        "description": "Quando você atinge uma criatura com um ataque com arma, você pode gastar um dado de superioridade para tentar desarmar o alvo."
      },
      "distracting_strike": {
        "name": "Ataque Distrativo",
        "description": "Quando você atinge uma criatura com um ataque com arma, você pode gastar um dado de superioridade para distrair a criatura."
      },
      "evasive_footwork": {
        "name": "Trabalho de pés evasivo",
        "description": "Quando você se move, você pode gastar um dado de superioridade e adicionar o resultado à sua CA até parar de se mover."
      },
      "feinting_attack": {
        "name": "Finta Ataque",
        "description": "Você pode gastar um dado de superioridade e usar uma ação bônus para fingir, ganhando vantagem em seu próximo ataque contra uma criatura."
      },
      "goading_attack": {
        "name": "Incitando Ataque",
        "description": "Quando você acerta um ataque com arma, você pode gastar um dado de superioridade para incitar o alvo a atacar você."
      },
      "lunging_attack": {
        "name": "Ataque Pulmonar",
        "description": "Quando você faz um ataque com arma corpo a corpo, você pode gastar um dado de superioridade para aumentar seu alcance para esse ataque."
      },
      "maneuvering_attack": {
        "name": "Manobrando Ataque",
        "description": "Quando você acerta com um ataque com arma, você pode gastar um dado de superioridade para permitir que um aliado se mova sem provocar o alvo."
      },
      "menacing_attack": {
        "name": "Ataque ameaçador",
        "description": "Quando você acerta um ataque com arma, você pode gastar um dado de superioridade para tentar assustar o alvo."
      },
      "parry": {
        "name": "Desviar",
        "description": "Quando outra criatura causa dano a você com um ataque corpo a corpo, você pode gastar um dado de superioridade para reduzir o dano."
      },
      "precision_attack": {
        "name": "Ataque de Precisão",
        "description": "Quando você faz uma jogada de ataque com arma, você pode gastar um dado de superioridade e adicioná-lo à jogada."
      },
      "pushing_attack": {
        "name": "Empurrando Ataque",
        "description": "Quando você acerta um ataque com arma, você pode gastar um dado de superioridade para tentar afastar o alvo."
      },
      "rally": {
        "name": "Corrida",
        "description": "No seu turno, você pode gastar um dado de superioridade e usar uma ação bônus para reforçar um aliado com pontos de vida temporários."
      },
      "riposte": {
        "name": "Resposta",
        "description": "Quando uma criatura erra você em um ataque corpo a corpo, você pode gastar um dado de superioridade para fazer um ataque corpo a corpo com arma contra ela."
      },
      "sweeping_attack": {
        "name": "Ataque arrebatador",
        "description": "Quando você acerta um ataque com arma corpo a corpo, você pode gastar um dado de superioridade para causar dano a outra criatura ao seu alcance."
      },
      "trip_attack": {
        "name": "Ataque de viagem",
        "description": "Quando você acerta um ataque com arma, você pode gastar um dado de superioridade para tentar derrubar o alvo."
      }
    },

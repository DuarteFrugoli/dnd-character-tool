{
  "optionSources": {
    "battle_master_maneuvers": {
      "commanders_strike": {
        "name": "指挥官的打击",
        "description": "当你采取攻击动作时，你可以放弃一次攻击并使用奖励动作来指挥盟友进行攻击。"
      },
      "disarming_attack": {
        "name": "解除攻击",
        "description": "当你用武器攻击击中一个生物时，你可以花费一个优势骰子来尝试解除目标的武装。"
      },
      "distracting_strike": {
        "name": "分散攻击",
        "description": "当你用武器攻击击中一个生物时，你可以花费一个优势骰子来分散该生物的注意力。"
      },
      "evasive_footwork": {
        "name": "回避步法",
        "description": "当你移动时，你可以消耗一个优势骰子并将掷骰添加到你的AC中，直到你停止移动。"
      },
      "feinting_attack": {
        "name": "佯攻",
        "description": "你可以花费一个优势骰子并使用奖励动作进行佯攻，在下次攻击生物时获得优势。"
      },
      "goading_attack": {
        "name": "刺激攻击",
        "description": "当你用武器攻击时，你可以花费一个优势骰子来刺激目标攻击你。"
      },
      "lunging_attack": {
        "name": "猛攻",
        "description": "当你进行近战武器攻击时，你可以花费一个优势骰子来增加你的攻击范围。"
      },
      "maneuvering_attack": {
        "name": "机动攻击",
        "description": "当你用武器攻击击中时，你可以花费一个优势骰子来让盟友在不挑衅目标的情况下移动。"
      },
      "menacing_attack": {
        "name": "来势汹汹的攻击",
        "description": "当你用武器攻击时，你可以花费一个优势骰子来试图吓唬目标。"
      },
      "parry": {
        "name": "招架",
        "description": "当另一个生物通过近战攻击对你造成伤害时，你可以花费优势骰子来减少伤害。"
      },
      "precision_attack": {
        "name": "精准攻击",
        "description": "当你进行武器攻击检定时，你可以花费一个优势骰子并将其添加到检定中。"
      },
      "pushing_attack": {
        "name": "推击",
        "description": "当你用武器攻击击中时，你可以花费一个优势骰子来尝试将目标推开。"
      },
      "rally": {
        "name": "集会",
        "description": "在你的回合中，你可以花费一个优势骰子并使用奖励动作来支持具有临时生命值的盟友。"
      },
      "riposte": {
        "name": "还击",
        "description": "当一个生物的近战攻击没有击中你时，你可以花费一个优势骰子来对其进行近战武器攻击。"
      },
      "sweeping_attack": {
        "name": "横扫进攻",
        "description": "当你用近战武器攻击击中时，你可以花费优势骰子来伤害范围内的另一个生物。"
      },
      "trip_attack": {
        "name": "绊倒攻击",
        "description": "当你用武器攻击击中时，你可以花费一个优势骰子来尝试将目标击倒。"
      }
    },

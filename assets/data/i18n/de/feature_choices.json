{
  "optionSources": {
    "battle_master_maneuvers": {
      "commanders_strike": {
        "name": "Kommandantenschlag",
        "description": "Wenn Sie die Aktion „Angreifen“ ausführen, können Sie auf einen Angriff verzichten und eine Bonusaktion nutzen, um einen Verbündeten zum Angriff anzuweisen."
      },
      "disarming_attack": {
        "name": "Entwaffnender Angriff",
        "description": "Wenn du eine Kreatur mit einem Waffenangriff triffst, kannst du einen Überlegenheitswürfel einsetzen, um zu versuchen, das Ziel zu entwaffnen."
      },
      "distracting_strike": {
        "name": "Ablenkender Schlag",
        "description": "Wenn du eine Kreatur mit einem Waffenangriff triffst, kannst du einen Überlegenheitswürfel ausgeben, um die Kreatur abzulenken."
      },
      "evasive_footwork": {
        "name": "Ausweichende Beinarbeit",
        "description": "Wenn Sie sich bewegen, können Sie einen Überlegenheitswürfel ausgeben und den Wurf zu Ihrer AC hinzufügen, bis Sie aufhören, sich zu bewegen."
      },
      "feinting_attack": {
        "name": "Finting-Angriff",
        "description": "Sie können einen Überlegenheitswürfel einsetzen und eine Bonusaktion für eine Finte nutzen, um sich bei Ihrem nächsten Angriff gegen eine Kreatur einen Vorteil zu verschaffen."
      },
      "goading_attack": {
        "name": "Anspornender Angriff",
        "description": "Wenn Sie mit einer Waffe zuschlagen, können Sie einen Überlegenheitswürfel einsetzen, um das Ziel dazu zu bewegen, Sie anzugreifen."
      },
      "lunging_attack": {
        "name": "Ausfallangriff",
        "description": "Wenn Sie einen Nahkampfwaffenangriff ausführen, können Sie einen Überlegenheitswürfel ausgeben, um Ihre Reichweite für diesen Angriff zu erhöhen."
      },
      "maneuvering_attack": {
        "name": "Manövrierangriff",
        "description": "Wenn Sie mit einem Waffenangriff zuschlagen, können Sie einen Überlegenheitswürfel ausgeben, um einem Verbündeten die Möglichkeit zu geben, sich zu bewegen, ohne das Ziel zu provozieren."
      },
      "menacing_attack": {
        "name": "Bedrohlicher Angriff",
        "description": "Wenn Sie mit einem Waffenangriff zuschlagen, können Sie einen Überlegenheitswürfel einsetzen, um zu versuchen, das Ziel zu erschrecken."
      },
      "parry": {
        "name": "Parieren",
        "description": "Wenn eine andere Kreatur dir mit einem Nahkampfangriff Schaden zufügt, kannst du einen Überlegenheitswürfel einsetzen, um den Schaden zu verringern."
      },
      "precision_attack": {
        "name": "Präzisionsangriff",
        "description": "Wenn Sie einen Waffenangriffswurf durchführen, können Sie einen Überlegenheitswürfel ausgeben und ihn zum Wurf hinzufügen."
      },
      "pushing_attack": {
        "name": "Push-Angriff",
        "description": "Wenn Sie mit einem Waffenangriff zuschlagen, können Sie einen Überlegenheitswürfel einsetzen, um zu versuchen, das Ziel wegzustoßen."
      },
      "rally": {
        "name": "Rallye",
        "description": "In deinem Zug kannst du einen Überlegenheitswürfel ausgeben und eine Bonusaktion nutzen, um einen Verbündeten mit temporären Trefferpunkten zu stärken."
      },
      "riposte": {
        "name": "Gegenrede",
        "description": "Wenn eine Kreatur dich mit einem Nahkampfangriff verfehlt, kannst du einen Überlegenheitswürfel ausgeben, um einen Nahkampfwaffenangriff gegen sie durchzuführen."
      },
      "sweeping_attack": {
        "name": "Durchgreifender Angriff",
        "description": "Wenn Sie mit einem Nahkampfwaffenangriff zuschlagen, können Sie einen Überlegenheitswürfel ausgeben, um einer anderen Kreatur in Reichweite Schaden zuzufügen."
      },
      "trip_attack": {
        "name": "Trip Attack",
        "description": "Wenn Sie mit einem Waffenangriff zuschlagen, können Sie einen Überlegenheitswürfel einsetzen, um zu versuchen, das Ziel zu Boden zu werfen."
      }
    },

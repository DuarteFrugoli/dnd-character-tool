{
  "optionSources": {
    "battle_master_maneuvers": {
      "commanders_strike": {
        "name": "Командирский удар",
        "description": "Совершая действие «Атака», вы можете отказаться от одной атаки и использовать бонусное действие, чтобы направить союзника на удар."
      },
      "disarming_attack": {
        "name": "Обезоруживающая атака",
        "description": "Когда вы поражаете существо атакой оружием, вы можете потратить кубик превосходства, чтобы попытаться обезоружить цель."
      },
      "distracting_strike": {
        "name": "Отвлекающий удар",
        "description": "Когда вы поражаете существо атакой оружием, вы можете потратить кубик превосходства, чтобы отвлечь существо."
      },
      "evasive_footwork": {
        "name": "Уклоняющаяся работа ног",
        "description": "Когда вы двигаетесь, вы можете потратить кубик превосходства и добавлять бросок к вашему AC, пока не перестанете двигаться."
      },
      "feinting_attack": {
        "name": "Ложная атака",
        "description": "Вы можете потратить кубик превосходства и использовать бонусное действие для обмана, получая преимущество при следующей атаке по существу."
      },
      "goading_attack": {
        "name": "Подстрекающая атака",
        "description": "Когда вы наносите удар оружием, вы можете потратить кубик превосходства, чтобы спровоцировать цель атаковать вас."
      },
      "lunging_attack": {
        "name": "Стремительная атака",
        "description": "Когда вы совершаете рукопашную атаку оружием, вы можете потратить кубик превосходства, чтобы увеличить дальность действия этой атаки."
      },
      "maneuvering_attack": {
        "name": "Маневренная атака",
        "description": "Когда вы наносите атаку оружием, вы можете потратить кубик превосходства, чтобы позволить союзнику двигаться, не провоцируя цель."
      },
      "menacing_attack": {
        "name": "Угрожающая атака",
        "description": "Когда вы наносите удар оружием, вы можете потратить кубик превосходства, чтобы попытаться напугать цель."
      },
      "parry": {
        "name": "Парировать",
        "description": "Когда другое существо наносит вам урон рукопашной атакой, вы можете потратить кубик превосходства, чтобы уменьшить урон."
      },
      "precision_attack": {
        "name": "Точная атака",
        "description": "Когда вы делаете бросок атаки оружием, вы можете потратить кубик превосходства и добавить его к броску."
      },
      "pushing_attack": {
        "name": "Толкающая атака",
        "description": "Когда вы наносите удар оружием, вы можете потратить кубик превосходства, чтобы попытаться оттолкнуть цель."
      },
      "rally": {
        "name": "Ралли",
        "description": "В свой ход вы можете потратить кубик превосходства и использовать бонусное действие, чтобы поддержать союзника временными очками жизни."
      },
      "riposte": {
        "name": "ответный удар",
        "description": "Когда существо промахивается по вам рукопашной атакой, вы можете потратить кубик превосходства, чтобы провести по нему рукопашную атаку оружием."
      },
      "sweeping_attack": {
        "name": "Размашистая атака",
        "description": "Когда вы наносите удар рукопашной атакой оружием, вы можете потратить кубик превосходства, чтобы нанести урон другому существу в пределах досягаемости."
      },
      "trip_attack": {
        "name": "Поездка Атака",
        "description": "Когда вы наносите удар оружием, вы можете потратить кубик превосходства, чтобы попытаться сбить цель с ног."
      }
    },

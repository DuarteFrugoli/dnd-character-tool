{
  "optionSources": {
    "battle_master_maneuvers": {
      "commanders_strike": {
        "name": "Frappe du commandant",
        "description": "Lorsque vous effectuez l'action Attaque, vous pouvez renoncer à une attaque et utiliser une action bonus pour ordonner à un allié de frapper."
      },
      "disarming_attack": {
        "name": "Attaque désarmante",
        "description": "Lorsque vous touchez une créature avec une attaque avec une arme, vous pouvez dépenser un dé de supériorité pour tenter de désarmer la cible."
      },
      "distracting_strike": {
        "name": "Frappe distrayante",
        "description": "Lorsque vous touchez une créature avec une attaque avec une arme, vous pouvez dépenser un dé de supériorité pour distraire la créature."
      },
      "evasive_footwork": {
        "name": "Jeu de jambes évasif",
        "description": "Lorsque vous vous déplacez, vous pouvez dépenser un dé de supériorité et ajouter le jet à votre CA jusqu'à ce que vous arrêtiez de bouger."
      },
      "feinting_attack": {
        "name": "Attaque de feinte",
        "description": "Vous pouvez dépenser un dé de supériorité et utiliser une action bonus pour feinter, obtenant ainsi un avantage lors de votre prochaine attaque contre une créature."
      },
      "goading_attack": {
        "name": "Attaque d'aiguillon",
        "description": "Lorsque vous frappez avec une arme, vous pouvez dépenser un dé de supériorité pour inciter la cible à vous attaquer."
      },
      "lunging_attack": {
        "name": "Attaque brusque",
        "description": "Lorsque vous effectuez une attaque au corps à corps avec une arme, vous pouvez dépenser un dé de supériorité pour augmenter la portée de cette attaque."
      },
      "maneuvering_attack": {
        "name": "Attaque de manœuvre",
        "description": "Lorsque vous frappez avec une arme, vous pouvez dépenser un dé de supériorité pour permettre à un allié de bouger sans provoquer la cible."
      },
      "menacing_attack": {
        "name": "Attaque menaçante",
        "description": "Lorsque vous frappez avec une arme, vous pouvez dépenser un dé de supériorité pour tenter d'effrayer la cible."
      },
      "parry": {
        "name": "Parer",
        "description": "Lorsqu'une autre créature vous blesse avec une attaque au corps à corps, vous pouvez dépenser un dé de supériorité pour réduire les dégâts."
      },
      "precision_attack": {
        "name": "Attaque de précision",
        "description": "Lorsque vous effectuez un jet d’attaque avec une arme, vous pouvez dépenser un dé de supériorité et l’ajouter au jet."
      },
      "pushing_attack": {
        "name": "Attaque poussée",
        "description": "Lorsque vous frappez avec une arme, vous pouvez dépenser un dé de supériorité pour tenter de repousser la cible."
      },
      "rally": {
        "name": "Rallier",
        "description": "À votre tour, vous pouvez dépenser un dé de supériorité et utiliser une action bonus pour renforcer un allié avec des points de vie temporaires."
      },
      "riposte": {
        "name": "Riposte",
        "description": "Lorsqu'une créature vous manque lors d'une attaque au corps à corps, vous pouvez dépenser un dé de supériorité pour lancer une attaque au corps à corps contre elle."
      },
      "sweeping_attack": {
        "name": "Attaque radicale",
        "description": "Lorsque vous frappez avec une attaque au corps à corps avec une arme, vous pouvez dépenser un dé de supériorité pour endommager une autre créature à portée."
      },
      "trip_attack": {
        "name": "Attaque de voyage",
        "description": "Lorsque vous frappez avec une arme, vous pouvez dépenser un dé de supériorité pour tenter de mettre la cible à terre."
      }
    },

{
  "optionSources": {
    "battle_master_maneuvers": {
      "commanders_strike": {
        "name": "Colpo del comandante",
        "description": "Quando esegui l'azione Attacco, puoi rinunciare a un attacco e utilizzare un'azione bonus per ordinare a un alleato di colpire."
      },
      "disarming_attack": {
        "name": "Attacco disarmante",
        "description": "Quando colpisci una creatura con un attacco con un'arma, puoi spendere un dado superiorità per tentare di disarmare il bersaglio."
      },
      "distracting_strike": {
        "name": "Colpo distraente",
        "description": "Quando colpisci una creatura con un attacco con un'arma, puoi spendere un dado superiorità per distrarre la creatura."
      },
      "evasive_footwork": {
        "name": "Gioco di gambe evasivo",
        "description": "Quando ti muovi, puoi spendere un dado superiorità e aggiungere il risultato alla tua AC finché non smetti di muoverti."
      },
      "feinting_attack": {
        "name": "Attacco con finta",
        "description": "Puoi spendere un dado superiorità e utilizzare un'azione bonus per fintare, ottenendo vantaggio al tuo prossimo attacco contro una creatura."
      },
      "goading_attack": {
        "name": "Attacco pungente",
        "description": "Quando colpisci con un attacco con un'arma, puoi spendere un dado superiorità per spingere il bersaglio ad attaccarti."
      },
      "lunging_attack": {
        "name": "Attacco in affondo",
        "description": "Quando effettui un attacco con un'arma da mischia, puoi spendere un dado superiorità per aumentare la portata di quell'attacco."
      },
      "maneuvering_attack": {
        "name": "Attacco di manovra",
        "description": "Quando colpisci con un attacco con un'arma, puoi spendere un dado superiorità per consentire a un alleato di muoversi senza provocare dal bersaglio."
      },
      "menacing_attack": {
        "name": "Attacco minaccioso",
        "description": "Quando colpisci con un attacco con arma, puoi spendere un dado superiorità per tentare di spaventare il bersaglio."
      },
      "parry": {
        "name": "Parare",
        "description": "Quando un'altra creatura ti danneggia con un attacco in mischia, puoi spendere un dado superiorità per ridurre il danno."
      },
      "precision_attack": {
        "name": "Attacco di precisione",
        "description": "Quando effettui un tiro per colpire con un'arma, puoi spendere un dado superiorità e aggiungerlo al tiro."
      },
      "pushing_attack": {
        "name": "Attacco spingente",
        "description": "Quando colpisci con un attacco con arma, puoi spendere un dado superiorità per tentare di respingere il bersaglio."
      },
      "rally": {
        "name": "Rally",
        "description": "Durante il tuo turno, puoi spendere un dado superiorità e utilizzare un'azione bonus per rafforzare un alleato con punti ferita temporanei."
      },
      "riposte": {
        "name": "Risposta",
        "description": "Quando una creatura ti manca con un attacco in mischia, puoi spendere un dado superiorità per effettuare un attacco con arma da mischia contro di essa."
      },
      "sweeping_attack": {
        "name": "Attacco devastante",
        "description": "Quando colpisci con un attacco con arma da mischia, puoi spendere un dado superiorità per danneggiare un'altra creatura a portata."
      },
      "trip_attack": {
        "name": "Attacco in viaggio",
        "description": "Quando colpisci con un attacco con arma, puoi spendere un dado superiorità per tentare di buttare a terra il bersaglio."
      }
    },

{
  "optionSources": {
    "battle_master_maneuvers": {
      "commanders_strike": {
        "name": "커맨더스 스트라이크",
        "description": "공격 행동을 취하면 한 번의 공격을 포기하고 보너스 행동을 사용하여 아군에게 공격을 지시할 수 있습니다."
      },
      "disarming_attack": {
        "name": "무장 해제 공격",
        "description": "무기 공격으로 생물을 공격할 때, 우월성 주사위를 사용하여 대상을 무장 해제할 수 있습니다."
      },
      "distracting_strike": {
        "name": "주의를 산만하게 하는 일격",
        "description": "무기 공격으로 생물을 공격하면 우월 주사위를 사용하여 생물의 주의를 분산시킬 수 있습니다."
      },
      "evasive_footwork": {
        "name": "회피적인 발놀림",
        "description": "이동할 때 우월성 주사위를 소비하고 이동을 멈출 때까지 AC에 굴림을 추가할 수 있습니다."
      },
      "feinting_attack": {
        "name": "페인팅 공격",
        "description": "당신은 우월성 주사위를 소비하고 보너스 행동을 사용하여 페인트를 칠 수 있으며, 생물에 대한 다음 공격에서 이점을 얻을 수 있습니다."
      },
      "goading_attack": {
        "name": "고딩 공격",
        "description": "무기 공격으로 공격할 때, 우월성 주사위를 사용하여 대상이 당신을 공격하도록 유도할 수 있습니다."
      },
      "lunging_attack": {
        "name": "돌진 공격",
        "description": "근접 무기 공격을 할 때 우월 주사위를 사용하여 해당 공격에 대한 범위를 늘릴 수 있습니다."
      },
      "maneuvering_attack": {
        "name": "기동공격",
        "description": "무기 공격으로 명중할 때, 우월성 주사위를 소비하여 대상으로부터 자극을 받지 않고 아군이 움직일 수 있도록 할 수 있습니다."
      },
      "menacing_attack": {
        "name": "위협적인 공격",
        "description": "무기 공격으로 명중할 때, 우월성 주사위를 사용하여 대상에게 겁을 주려고 시도할 수 있습니다."
      },
      "parry": {
        "name": "패리",
        "description": "다른 생물이 근접 공격으로 당신에게 피해를 입힐 때, 당신은 우월 주사위를 소비하여 피해를 줄일 수 있습니다."
      },
      "precision_attack": {
        "name": "정밀 공격",
        "description": "무기 공격 굴림을 할 때 우월성 주사위를 소모하여 굴림에 추가할 수 있습니다."
      },
      "pushing_attack": {
        "name": "밀어붙이는 공격",
        "description": "무기 공격으로 명중할 때, 우월성 주사위를 사용하여 대상을 밀어낼 수 있습니다."
      },
      "rally": {
        "name": "랠리",
        "description": "당신의 차례에 당신은 우월성 주사위를 소비하고 보너스 행동을 사용하여 임시 체력으로 아군을 강화할 수 있습니다."
      },
      "riposte": {
        "name": "반격",
        "description": "생물이 근접 공격으로 당신을 놓칠 때, 당신은 우월성 주사위를 사용하여 근접 무기 공격을 할 수 있습니다."
      },
      "sweeping_attack": {
        "name": "휩쓸기 공격",
        "description": "근접 무기 공격으로 명중할 때 우월성 주사위를 사용하여 도달 범위 내의 다른 생물에게 피해를 줄 수 있습니다."
      },
      "trip_attack": {
        "name": "트립 어택",
        "description": "무기 공격으로 명중할 때 우월성 주사위를 사용하여 대상을 넘어뜨리려고 시도할 수 있습니다."
      }
    },

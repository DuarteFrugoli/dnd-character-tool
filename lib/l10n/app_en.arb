  "whatsNew3RulesTitle": "D&D 2024 rules",

  "@whatsNew3RulesTitle": { "description": "3.0.0 announcement: 2024 rules title." },

  "whatsNew3RulesBody": "Choose D&D 5e (2014) or 5.5e (2024) when creating a character. 2024 characters level from 1 to 20 with subclasses, feats, Epic Boons, multiclassing and Weapon Mastery.",

  "@whatsNew3RulesBody": { "description": "3.0.0 announcement: 2024 rules details." },

  "whatsNew3RestsTitle": "Rests and conditions",

  "@whatsNew3RestsTitle": { "description": "3.0.0 announcement: rests and conditions title." },

  "whatsNew3RestsBody": "2024 long rests recover every Hit Die and remove one Exhaustion level, Exhaustion affects d20 rolls and Speed, and short rests offer features such as Arcane Recovery.",


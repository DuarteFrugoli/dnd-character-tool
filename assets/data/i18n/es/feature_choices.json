{
  "optionSources": {
    "battle_master_maneuvers": {
      "commanders_strike": {
        "name": "Golpe del comandante",
        "description": "Cuando realizas la acción de Ataque, puedes renunciar a un ataque y usar una acción adicional para indicarle a un aliado que ataque."
      },
      "disarming_attack": {
        "name": "Ataque desarmante",
        "description": "Cuando golpeas a una criatura con un ataque con arma, puedes gastar un dado de superioridad para intentar desarmar al objetivo."
      },
      "distracting_strike": {
        "name": "Golpe de distracción",
        "description": "Cuando golpeas a una criatura con un ataque con arma, puedes gastar un dado de superioridad para distraer a la criatura."
      },
      "evasive_footwork": {
        "name": "Juego de pies evasivo",
        "description": "Cuando te mueves, puedes gastar un dado de superioridad y agregar la tirada a tu CA hasta que dejes de moverte."
      },
      "feinting_attack": {
        "name": "Ataque de finta",
        "description": "Puedes gastar un dado de superioridad y usar una acción adicional para fintar, obteniendo ventaja en tu próximo ataque contra una criatura."
      },
      "goading_attack": {
        "name": "Ataque de incitación",
        "description": "Cuando golpeas con un ataque con arma, puedes gastar un dado de superioridad para incitar al objetivo a atacarte."
      },
      "lunging_attack": {
        "name": "Ataque de acometida",
        "description": "Cuando realizas un ataque con arma cuerpo a cuerpo, puedes gastar un dado de superioridad para aumentar tu alcance para ese ataque."
      },
      "maneuvering_attack": {
        "name": "Ataque de maniobra",
        "description": "Cuando golpeas con un ataque con arma, puedes gastar un dado de superioridad para permitir que un aliado se mueva sin provocar al objetivo."
      },
      "menacing_attack": {
        "name": "Ataque amenazante",
        "description": "Cuando golpeas con un ataque con arma, puedes gastar un dado de superioridad para intentar asustar al objetivo."
      },
      "parry": {
        "name": "Parar",
        "description": "Cuando otra criatura te daña con un ataque cuerpo a cuerpo, puedes gastar un dado de superioridad para reducir el daño."
      },
      "precision_attack": {
        "name": "Ataque de precisión",
        "description": "Cuando haces una tirada de ataque con arma, puedes gastar un dado de superioridad y añadirlo a la tirada."
      },
      "pushing_attack": {
        "name": "Ataque de empuje",
        "description": "Cuando golpeas con un ataque con arma, puedes gastar un dado de superioridad para intentar alejar al objetivo."
      },
      "rally": {
        "name": "Reunión",
        "description": "En tu turno, puedes gastar un dado de superioridad y usar una acción adicional para reforzar a un aliado con puntos de vida temporales."
      },
      "riposte": {
        "name": "Estocada",
        "description": "Cuando una criatura te falla con un ataque cuerpo a cuerpo, puedes gastar un dado de superioridad para realizar un ataque con arma cuerpo a cuerpo contra ella."
      },
      "sweeping_attack": {
        "name": "Ataque de barrido",
        "description": "Cuando golpeas con un ataque con arma cuerpo a cuerpo, puedes gastar un dado de superioridad para dañar a otra criatura que esté a tu alcance."
      },
      "trip_attack": {
        "name": "Ataque de viaje",
        "description": "Cuando golpeas con un ataque con arma, puedes gastar un dado de superioridad para intentar derribar al objetivo."
      }
    },

{
  "optionSources": {
    "battle_master_maneuvers": {
      "commanders_strike": {
        "name": "コマンダーズ・ストライク",
        "description": "攻撃アクションを実行すると、1 回の攻撃を省略し、ボーナス アクションを使用して味方に攻撃を指示することができます。"
      },
      "disarming_attack": {
        "name": "武装解除攻撃",
        "description": "武器攻撃でクリーチャーを攻撃すると、優位性ダイスを消費してターゲットの武装解除を試みることができます。"
      },
      "distracting_strike": {
        "name": "気を散らす攻撃",
        "description": "クリーチャーに武器攻撃を当てると、優位性ダイスを消費してクリーチャーの注意をそらすことができます。"
      },
      "evasive_footwork": {
        "name": "回避フットワーク",
        "description": "あなたが移動するとき、あなたは優勢ダイスを消費し、移動を止めるまであなたのACにロールを追加することができます。"
      },
      "feinting_attack": {
        "name": "フェイント攻撃",
        "description": "優位性ダイスを消費し、ボーナス アクションを使用してフェイントを行うことで、クリーチャーに対する次の攻撃でアドバンテージを得ることができます。"
      },
      "goading_attack": {
        "name": "煽り攻撃",
        "description": "武器攻撃を当てると、優位性ダイスを消費してターゲットを攻撃するように仕向けることができます。"
      },
      "lunging_attack": {
        "name": "突進攻撃",
        "description": "近接武器攻撃を行うとき、優位性ダイスを消費して、その攻撃のリーチを増やすことができます。"
      },
      "maneuvering_attack": {
        "name": "マニューバ攻撃",
        "description": "武器攻撃を命中させると、優位性ダイスを消費して、ターゲットから挑発せずに味方を移動させることができます。"
      },
      "menacing_attack": {
        "name": "脅威の攻撃",
        "description": "武器攻撃を当てると、優位性ダイスを消費してターゲットを怖がらせることができます。"
      },
      "parry": {
        "name": "パリー",
        "description": "他のクリーチャーが近接攻撃であなたにダメージを与えたとき、あなたはダメージを軽減するために優位性ダイスを消費できます。"
      },
      "precision_attack": {
        "name": "精密攻撃",
        "description": "武器攻撃ロールを作成するとき、優位性ダイスを消費してロールに追加できます。"
      },
      "pushing_attack": {
        "name": "押し攻撃",
        "description": "武器攻撃を当てると、優位性ダイスを消費してターゲットを押しのけようとすることができます。"
      },
      "rally": {
        "name": "ラリー",
        "description": "自分のターンでは、優位性ダイスを消費し、ボーナス アクションを使用して味方を一時的なヒット ポイントで強化できます。"
      },
      "riposte": {
        "name": "リポスト",
        "description": "クリーチャーが近接攻撃を外した場合、優位性ダイスを消費してそれに対して近接武器攻撃を行うことができます。"
      },
      "sweeping_attack": {
        "name": "スイープアタック",
        "description": "近接武器攻撃を当てると、優位性ダイスを消費して、手の届く範囲にある別のクリーチャーにダメージを与えることができます。"
      },
      "trip_attack": {
        "name": "トリップアタック",
        "description": "武器攻撃を当てると、優位性ダイスを消費してターゲットを伏せさせようとすることができます。"
      }
    },

  "feats": [
    {
      "id": "crafter",
      "name": "Crafter",
      "category": "origin",
      "prerequisite": null,
      "repeatable": false,
      "description": "Gain proficiency with three different Artisan's Tools from the Fast Crafting list. Nonmagical items you buy cost you 20% less. When you finish a Long Rest, you can use one of those tools to make one simple piece of gear tied to it, such as a Ladder, Shovel or Lamp; it falls apart when you finish your next Long Rest."
    },
    {
      "id": "healer",
      "name": "Healer",
      "category": "origin",
      "prerequisite": null,
      "repeatable": false,
      "description": "With a Healer's Kit, you can take the Utilize action and expend one use of the kit to tend a creature within {{distance:5ft}}. That creature can spend one Hit Die; you roll it, and the creature regains Hit Points equal to the roll plus your Proficiency Bonus. Whenever you roll dice to restore Hit Points with a spell or this feat, you can reroll any die that shows a 1 and must use the new roll."
    },
    {
      "id": "lucky",
      "name": "Lucky",
      "category": "origin",
      "prerequisite": null,
      "repeatable": false,
      "description": "You have Luck Points equal to your Proficiency Bonus and regain them all when you finish a Long Rest. Spend one to give yourself Advantage on a D20 Test, or to give Disadvantage to an attack roll made against you."
    },
    {
      "id": "musician",
      "name": "Musician",
      "category": "origin",
      "prerequisite": null,
      "repeatable": false,
      "description": "Gain proficiency with three Musical Instruments of your choice. As you finish a Short or Long Rest, you can play one of them and give Heroic Inspiration to allies who hear the song, up to a number equal to your Proficiency Bonus."
    },
    {
      "id": "tavern_brawler",
      "name": "Tavern Brawler",
      "category": "origin",
      "prerequisite": null,
      "repeatable": false,
      "description": "Your Unarmed Strike can deal Bludgeoning damage equal to 1d4 + your Strength modifier, and you can reroll a 1 on that die, using the new roll. You have proficiency with improvised weapons. Once per turn, when you hit a creature with an Unarmed Strike as part of the Attack action, you can also push it {{distance:5ft}} straight away from you."
    },
    {
      "id": "tough",
      "name": "Tough",
      "category": "origin",
      "prerequisite": null,
      "repeatable": false,
      "description": "Your Hit Point maximum increases by twice your character level when you gain this feat, and by 2 more each time you gain a character level afterward."
    }
  ],
